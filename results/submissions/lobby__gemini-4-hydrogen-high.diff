+  ctx.strokeStyle = theme === "dark" ? "rgba(210, 220, 240, 0.16)" : "rgba(110, 96, 76, 0.14)";
+  ctx.lineWidth = 1;
+  ctx.beginPath();
+  ctx.arc(w * 0.5, h * 0.5, w * 0.34, 0, Math.PI * 2);
+  ctx.stroke();
