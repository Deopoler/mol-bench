+    grad.addColorStop(0, `hsla(${b.hue}, 58%, 74%, 0.52)`);
+    grad.addColorStop(0.55, `hsla(${b.hue}, 48%, 78%, 0.22)`);
+    grad.addColorStop(1, `hsla(${b.hue}, 48%, 82%, 0)`);
+  }
