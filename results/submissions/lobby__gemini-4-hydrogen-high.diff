+    }
+    renderAll(state.clockMs);
+    if (window.__benchHostControl?.isRafOverrideActive?.()) {
+      return;
+    }
+    await new Promise((resolve) => {
+      requestAnimationFrame(() => requestAnimationFrame(resolve));
+    });
+  },
+  state() {
+    return {
+      route: state.route,
+      lang: state.lang,
+      theme: getEffectiveTheme(),
+    };
+  },
+  stats() {
+    return {
+      drawCalls: 1,
+      triangles: 2,
+    };
+  },
+};
