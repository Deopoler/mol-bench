+      <p class="alt" id="room-alt"></p>
+      <div class="swatch swatch-wide" id="room-swatch" aria-hidden="true"></div>
+      <p class="prose" id="room-summary" data-bench="body" lang="ko"></p>
+    </div>
+  </section>
+</main>
+
+<footer class="site-footer" data-bench="footer">
+  <div class="container">
+    <p><span lang="en">Museum of Light · Seoul</span> — <span data-i18n="tagline">빛으로 지은 디지털 방들</span></p>
+  </div>
+</footer>
+
+<script src="./app.js"></script>
+</body>
+</html>
diff --git a/lobby/style.css b/lobby/style.css
new file mode 100644
index 0000000..d42a160
--- /dev/null
+++ b/lobby/style.css
@@ -0,0 +1,305 @@
+/* Museum of Light — lobby. 4px rhythm, five type sizes (14/16/20/28/64), system fonts only. */
+:root {
+  --bg: #faf8f3;
+  --surface: #ffffff;
+  --ink: #1b1a17;
+  --muted: #5b5850;
+  --ink-2: #55524a;
+  --line: #ddd8cc;
+  --focus: #1b1a17;
+  --glow: oklch(0.92 0.09 85 / 0.6);
+  --tint-l: 0.93;
+  --tint-c: 0.04;
+  --shadow: 0 1px 2px rgb(27 26 23 / 0.06), 0 8px 24px rgb(27 26 23 / 0.06);
+
+  --fs-xs: 14px;
+  --fs-m: 16px;
+  --fs-l: 20px;
+  --fs-xl: 28px;
+  --fs-hero: clamp(36px, 5vw, 64px);
+
+  --sans: system-ui, -apple-system, "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Noto Serif KR", "Nanum Myeongjo", Batang, Georgia, "Times New Roman", serif;
+  --view-ms: 360ms;
+  color-scheme: light;
+}
+:root[data-theme="dark"] {
+  --bg: #121110;
+  --surface: #1b1a18;
+  --ink: #f2eee6;
+  --muted: #b2ada1;
+  --ink-2: #d4cfc3;
+  --line: #34312c;
+  --focus: #f2eee6;
+  --glow: oklch(0.36 0.07 85 / 0.55);
+  --tint-l: 0.27;
+  --tint-c: 0.05;
+  --shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px rgb(0 0 0 / 0.35);
+  color-scheme: dark;
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+[hidden] { display: none !important; }
+
+html { -webkit-text-size-adjust: 100%; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: var(--fs-m);
+  line-height: 1.5;
+  word-break: keep-all;
+  overflow-wrap: break-word;
+  line-break: strict;
+  text-rendering: optimizeLegibility;
+}
+h1, h2, h3, p, ul { margin: 0; padding: 0; }
+ul { list-style: none; }
+a { color: inherit; }
+button { font: inherit; }
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+main:focus, h1:focus, h2:focus { outline: none; }
+
+.container {
+  max-width: 1120px;
+  margin-inline: auto;
+  padding-inline: 16px;
+}
+@media (min-width: 768px) { .container { padding-inline: 24px; } }
+@media (min-width: 1200px) { .container { padding-inline: 32px; } }
+
+/* vertical rhythm helper: every gap is a multiple of 4px */
+.stack > * + * { margin-top: 24px; }
+
+/* skip link */
+.skip {
+  position: absolute;
+  left: 16px;
+  top: -80px;
+  z-index: 10;
+  padding: 12px 16px;
+  min-height: 44px;
+  display: inline-flex;
+  align-items: center;
+  background: var(--ink);
+  color: var(--bg);
+  border-radius: 8px;
+  font-size: var(--fs-xs);
+  text-decoration: none;
+}
+.skip:focus-visible { top: 8px; outline-color: var(--focus); outline-offset: 2px; }
+
+/* header */
+.site-header { border-bottom: 1px solid var(--line); }
+.bar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px 16px;
+  padding-block: 12px;
+}
+.brand {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  font-family: var(--serif);
+  font-size: var(--fs-l);
+  letter-spacing: 0.01em;
+  text-decoration: none;
+}
+.controls { display: flex; flex-wrap: wrap; gap: 8px; }
+
+/* buttons */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  min-width: 44px;
+  padding: 0 16px;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--ink);
+  font-size: var(--fs-xs);
+  line-height: 1;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 160ms ease, border-color 160ms ease;
+}
+.btn:hover { border-color: var(--ink); }
+.btn-primary {
+  min-height: 48px;
+  padding: 0 24px;
+  background: var(--ink);
+  border-color: var(--ink);
+  color: var(--bg);
+  font-size: var(--fs-m);
+}
+.btn-primary:hover { background: var(--ink); opacity: 0.88; }
+.back { font-size: var(--fs-m); }
+
+/* views */
+.view.enter { animation: view-in var(--view-ms) cubic-bezier(0.22, 0.61, 0.36, 1) both; }
+@keyframes view-in {
+  from { opacity: 0; transform: translateY(12px); }
+  to { opacity: 1; transform: none; }
+}
+
+/* hero */
+.hero {
+  display: flex;
+  align-items: center;
+  min-height: min(760px, 85vh);
+  padding-block: 48px 40px;
+  background:
+    radial-gradient(60% 90% at 88% 0%, var(--glow), transparent 70%),
+    radial-gradient(40% 60% at 0% 100%, var(--glow), transparent 75%);
+}
+.eyebrow {
+  font-size: var(--fs-xs);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.hero-title {
+  font-family: var(--serif);
+  font-weight: 400;
+  font-size: var(--fs-hero);
+  line-height: 1.2;
+  letter-spacing: -0.01em;
+  max-width: 16em;
+  color: var(--ink-2);
+  text-wrap: balance;
+}
+.hero > .container { width: 100%; }
+.hero .eyebrow + .hero-title, .room .eyebrow + .hero-title { margin-top: 16px; }
+.lede {
+  max-width: 32em;
+  color: var(--ink-2);
+  font-size: var(--fs-l);
+  line-height: 1.6;
+}
+.prose {
+  max-width: 32em;
+  font-size: var(--fs-m);
+  line-height: 1.75;
+}
+.alt { font-size: var(--fs-l); color: var(--muted); margin-top: 8px !important; }
+@media (min-width: 768px) { .hero { padding-block: 96px 64px; } }
+
+/* rooms */
+.rooms-section { padding-block: 48px; }
+.section-head { margin-bottom: 32px; }
+.section-head.stack > * + * { margin-top: 8px; }
+.h2 {
+  font-family: var(--serif);
+  font-weight: 400;
+  font-size: var(--fs-xl);
+  line-height: 1.3;
+}
+.count { font-size: var(--fs-xs); color: var(--muted); }
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
+  gap: 24px;
+}
+.grid > li { display: flex; min-width: 0; }
+.card { display: flex; flex: 1; min-width: 0; }
+.card-body {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 8px;
+  min-width: 0;
+  padding: 24px;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  color: inherit;
+  text-decoration: none;
+  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
+}
+a.card-body:hover { border-color: var(--ink); box-shadow: var(--shadow); transform: translateY(-2px); }
+.swatch {
+  display: block;
+  height: 96px;
+  margin-bottom: 8px;
+  border-radius: 12px;
+  background:
+    radial-gradient(120% 150% at 20% 0%, oklch(var(--l, 0.68) var(--c, 0.12) var(--h, 80)) 0%, oklch(var(--l, 0.68) var(--c, 0.12) var(--h, 80) / 0) 72%),
+    oklch(var(--tint-l) var(--tint-c) var(--h, 80));
+}
+.swatch-wide { height: 160px; margin: 32px 0 0; }
+.room .stack > .swatch-wide { margin-top: 32px; }
+.card-meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  font-size: var(--fs-xs);
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.badge {
+  display: inline-flex;
+  align-items: center;
+  padding: 4px 12px;
+  border: 1px solid var(--ink);
+  border-radius: 999px;
+  color: var(--ink);
+  letter-spacing: 0;
+  text-transform: none;
+}
+.card-title {
+  font-size: var(--fs-l);
+  font-weight: 600;
+  line-height: 1.4;
+}
+.card-alt { display: block; font-size: var(--fs-xs); line-height: 1.5; color: var(--muted); }
+.card-summary { font-size: var(--fs-m); line-height: 1.5; color: var(--muted); }
+.card-cta { display: block; margin-top: auto; padding-top: 8px; font-weight: 600; }
+.card-soon .card-body {
+  background: transparent;
+  border-style: dashed;
+}
+.card-soon .swatch {
+  background: repeating-linear-gradient(135deg, var(--line) 0 2px, transparent 2px 10px);
+}
+.card-soon .card-cta { color: var(--muted); font-weight: 400; }
+
+.empty {
+  max-width: 36em;
+  padding: 32px 24px;
+  border: 1px dashed var(--line);
+  border-radius: 16px;
+  color: var(--muted);
+  line-height: 1.75;
+}
+
+/* info + room + footer */
+.info { padding-block: 48px 64px; border-top: 1px solid var(--line); }
+.room { padding-block: 32px 64px; }
+@media (min-width: 768px) { .room { padding-block: 64px 96px; } }
+.site-footer { border-top: 1px solid var(--line); }
+.site-footer .container { padding-block: 32px; }
+.site-footer p { font-size: var(--fs-xs); color: var(--muted); }
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-delay: 0s !important;
+    transition-duration: 0.01ms !important;
+    transition-delay: 0s !important;
+    scroll-behavior: auto !important;
+  }
+  a.card-body:hover { transform: none; }
+}
