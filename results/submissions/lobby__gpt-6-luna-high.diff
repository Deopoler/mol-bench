-renderRooms();document.querySelector("[data-bench=body]").textContent="가".repeat(100);const roomId=()=>location.hash.startsWith('#/room/')?location.hash.slice(7):'lobby';window.__bench={version:1,ready:document.fonts.ready,setSeed(){renderRooms()},seek(){},resume(){},async renderFrame(){await new Promise(requestAnimationFrame)},state(){return{route:roomId(),lang:'ko',theme:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}},stats(){return{drawCalls:0,triangles:0}}};
+const root = document.querySelector("#room-list");
+const html = document.documentElement;
+const langToggle = document.querySelector('[data-bench="lang-toggle"]');
+const themeToggle = document.querySelector('[data-bench="theme-toggle"]');
+const colorPreference = window.matchMedia("(prefers-color-scheme: dark)");
+
+const copy = {
+  ko: {
+    kicker: "디지털 전시관 · 서울",
