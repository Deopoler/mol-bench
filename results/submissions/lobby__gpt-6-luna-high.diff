diff --git a/lobby/styles.css b/lobby/styles.css
new file mode 100644
index 0000000..26861cc
--- /dev/null
+++ b/lobby/styles.css
@@ -0,0 +1,415 @@
+@charset "UTF-8";
+
+:root {
+  color-scheme: light;
+  --paper: #f4f2ec;
+  --paper-raised: #faf9f5;
+  --ink: #252820;
+  --muted: #66695f;
+  --faint: #696d63;
+  --line: #dcdcd2;
+  --accent: #465c4b;
+  --accent-soft: #e5e9df;
+  --gold: #bc8753;
+  --focus: #8c4e2e;
+  --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", "Batang", "NanumMyeongjo", Georgia, serif;
+  --sans: "Segoe UI", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
+  font-family: var(--sans);
+  font-synthesis: none;
+  text-rendering: optimizeLegibility;
+  background: var(--paper);
+  color: var(--ink);
+}
+
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --paper: #1c211e;
+  --paper-raised: #252b27;
+  --ink: #edece3;
+  --muted: #b0b4a9;
+  --faint: #a0a69a;
+  --line: #3d463e;
+  --accent: #c6d2bc;
+  --accent-soft: #303a31;
+  --gold: #d0a373;
+  --focus: #f2b886;
+}
+
+* { box-sizing: border-box; }
+
+html {
+  min-width: 320px;
+  scroll-behavior: smooth;
+  scroll-padding-top: 32px;
+  background: var(--paper);
+}
+
+body {
+  min-width: 320px;
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-size: 16px;
+  line-height: 1.6;
+  transition: background-color 180ms ease, color 180ms ease;
+}
+
+button, a { font: inherit; }
+a { color: inherit; }
+button { color: inherit; }
+button:focus-visible, a:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 4px;
+  border-radius: 2px;
+}
+
+.page-shell {
+  width: min(100% - 64px, 1248px);
+  margin-inline: auto;
+}
+
+.site-header {
+  height: 92px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  border-bottom: 1px solid var(--line);
+}
+
+.wordmark {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.wordmark-mark {
+  width: 36px;
+  height: 36px;
+  display: grid;
+  place-items: center;
+  border: 1px solid var(--accent);
+  border-radius: 50%;
+  color: var(--accent);
+  font-family: var(--serif);
+  font-size: 24px;
+  line-height: 1;
+}
+
+.wordmark-name, .footer-brand, .footer-year {
+  font-size: 12px;
+  font-weight: 650;
+  letter-spacing: .12em;
+  line-height: 1.35;
+}
+
+.header-tools { display: flex; align-items: center; gap: 8px; }
+.quiet-button, .theme-button {
+  min-height: 44px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 8px 12px;
+  border: 1px solid transparent;
+  border-radius: 2px;
+  background: transparent;
+  cursor: pointer;
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: .06em;
+  transition: background-color 160ms ease, border-color 160ms ease;
+}
+.quiet-button:hover, .theme-button:hover { border-color: var(--line); background: var(--paper-raised); }
+.quiet-button::after { color: var(--muted); font-size: 16px; content: "↗"; }
+.theme-button::before { color: var(--gold); font-size: 16px; content: attr(data-symbol); }
+
+.welcome {
+  min-height: 504px;
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(280px, .78fr);
+  align-items: center;
+  padding: 64px 8.333% 68px;
+  border-bottom: 1px solid var(--line);
+  overflow: hidden;
+}
+
+.welcome-copy { position: relative; z-index: 1; max-width: 600px; }
+.eyebrow {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin: 0 0 24px;
+  color: var(--muted);
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: .11em;
+  line-height: 1.5;
+}
+.eyebrow::before { width: 24px; height: 1px; flex: 0 0 auto; background: var(--gold); content: ""; }
+
+.welcome h1 {
+  max-width: 620px;
+  margin: 0;
+  font-family: var(--serif);
+  font-size: clamp(44px, 5.1vw, 64px);
+  font-weight: 400;
+  letter-spacing: -.055em;
+  line-height: 1.3;
+  word-break: keep-all;
+  overflow-wrap: break-word;
+}
+
+.intro {
+  max-width: 40ch;
+  margin: 24px 0 0;
+  color: var(--muted);
+  font-size: 16px;
+  line-height: 1.75;
+  word-break: keep-all;
+  overflow-wrap: break-word;
+}
+:root[lang="en"] .intro { max-width: 58ch; }
+
+.scroll-cue {
+  min-height: 44px;
+  width: fit-content;
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  margin-top: 28px;
+  color: var(--accent);
+  font-size: 12px;
+  font-weight: 650;
+  letter-spacing: .05em;
+  text-decoration: none;
+}
+.scroll-cue:hover { color: var(--gold); }
+.scroll-line { width: 28px; height: 1px; background: currentColor; transition: width 160ms ease; }
+.scroll-cue:hover .scroll-line { width: 40px; }
+
+.welcome-art {
+  min-width: 0;
+  aspect-ratio: 1 / 1;
+  max-width: 400px;
+  width: 100%;
+  justify-self: end;
+  position: relative;
+  display: grid;
+  place-items: center;
+  isolation: isolate;
+}
+.art-halo {
+  position: absolute;
+  width: 65%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background: radial-gradient(circle, color-mix(in srgb, var(--gold) 19%, transparent) 0 42%, transparent 73%);
+  filter: blur(2px);
+}
+.art-disc {
+  position: relative;
+  width: 43%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background: radial-gradient(circle at 36% 31%, #e1bd8b 0 2%, #bb8b5f 25%, #586955 67%, #333f37 100%);
+  box-shadow: 0 16px 52px color-mix(in srgb, var(--ink) 16%, transparent), inset -14px -12px 28px #252b2780, inset 8px 10px 22px #f1d2a34a;
+}
+.art-disc::after {
+  position: absolute;
+  inset: 13%;
+  border: 1px solid #f1e0c360;
+  border-radius: inherit;
+  content: "";
+}
+.art-orbit { position: absolute; width: 78%; aspect-ratio: 1; border: 1px solid var(--line); border-radius: 50%; }
+.orbit-two { width: 94%; border-color: color-mix(in srgb, var(--line) 62%, transparent); }
+.welcome-art::before, .welcome-art::after {
+  position: absolute;
+  z-index: 1;
+  color: var(--muted);
+  font-size: 12px;
+  letter-spacing: .12em;
+  line-height: 1.6;
+  white-space: pre;
+}
+.welcome-art::before { top: 8%; right: 0; content: "FIG. 01\A LIGHT, IN A ROOM"; }
+.welcome-art::after { bottom: 8%; left: 0; content: "37°33′N  126°59′E"; }
+
+.collection { padding: 72px 8.333% 76px; }
+.section-heading {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  align-items: end;
+  gap: 32px;
+  margin-bottom: 32px;
+}
+.section-heading .eyebrow { margin-bottom: 12px; }
+.section-heading h2 {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 40px;
+  font-weight: 400;
+  letter-spacing: -.04em;
+  line-height: 1.25;
+  word-break: keep-all;
+}
+.collection-note {
+  margin: 0 0 4px 16px;
+  color: var(--muted);
+  font-size: 12px;
+  line-height: 1.75;
+  text-align: left;
+  word-break: keep-all;
+}
+.room-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
+.room-card {
+  min-width: 0;
+  min-height: 188px;
+  position: relative;
+  border-bottom: 1px solid var(--line);
+}
+.room-card:nth-child(odd) { border-right: 1px solid var(--line); }
+.room-card:nth-child(even) .room-link, .room-card:nth-child(even) .room-coming { padding-left: 32px; }
+.room-link, .room-coming {
+  min-height: 188px;
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  padding: 24px 32px 24px 0;
+  text-decoration: none;
+}
+.room-link::before { position: absolute; inset: 0; z-index: -1; background: var(--paper-raised); content: ""; opacity: 0; transition: opacity 180ms ease; }
+.room-link:hover::before, .room-link:focus-visible::before { opacity: 1; }
+.room-topline { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 14px; }
+.room-number { color: var(--faint); font-size: 12px; letter-spacing: .1em; }
+.room-status {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--accent);
+  font-size: 12px;
+  font-weight: 650;
+  letter-spacing: .1em;
+}
+.room-status::before { width: 6px; height: 6px; border-radius: 50%; background: var(--room-accent, currentColor); content: ""; }
+.room-title {
+  display: block;
+  max-width: 30ch;
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 24px;
+  font-weight: 400;
+  letter-spacing: -.025em;
+  line-height: 1.4;
+  word-break: keep-all;
+  overflow-wrap: anywhere;
+}
+.room-secondary { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.6; word-break: keep-all; overflow-wrap: anywhere; }
+.room-summary { margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.6; word-break: keep-all; overflow-wrap: anywhere; }
+.room-link::after { position: absolute; right: 0; bottom: 24px; color: var(--gold); content: "↗"; font-size: 16px; transition: transform 160ms ease; }
+.room-card:nth-child(even) .room-link::after { right: 32px; }
+.room-link:hover::after { transform: translate(3px, -3px); }
+.room-coming { color: var(--muted); }
+.room-coming .room-status { color: var(--faint); }
+.room-coming .room-status::before { background: var(--faint); }
+.room-coming .room-title { color: var(--muted); }
+.room-coming::after { position: absolute; top: 24px; right: 0; width: 24px; height: 24px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--faint); content: "·"; }
+.room-card:nth-child(even) .room-coming::after { right: 32px; }
+.empty-state {
+  margin: 0;
+  padding: 32px;
+  border: 1px solid var(--line);
+  border-top: 0;
+  color: var(--muted);
+  font-size: 16px;
+  line-height: 1.75;
+  text-align: center;
+  word-break: keep-all;
+}
+.empty-state[hidden] { display: none; }
+
+.closing-note {
+  min-height: 160px;
+  display: flex;
+  align-items: center;
+  padding: 32px;
+  border-top: 1px solid var(--line);
+  border-bottom: 1px solid var(--line);
+  text-align: left;
+}
+.closing-note p { position: relative; width: fit-content; margin: 0 0 0 8.333%; color: var(--muted); font-family: var(--serif); font-size: 24px; line-height: 1.6; word-break: keep-all; }
+.closing-note p::before { position: absolute; top: 8px; left: -40px; color: var(--gold); content: "✳"; font-family: var(--sans); font-size: 24px; }
+
+.site-footer {
+  min-height: 76px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  color: var(--muted);
+}
+.footer-brand, .footer-year { color: var(--faint); }
+.footer-place { font-size: 12px; word-break: keep-all; }
+
+.is-navigating .main-content { animation: enter-room 260ms ease-out both; }
+@keyframes enter-room {
+  from { opacity: .72; transform: translateY(8px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@media (max-width: 800px) {
+  .page-shell { width: min(100% - 48px, 680px); }
+  .site-header { height: 80px; }
+  .welcome { min-height: auto; grid-template-columns: minmax(0, 1fr) minmax(190px, .72fr); padding: 56px 0 64px; }
+  .welcome h1 { font-size: clamp(40px, 7vw, 56px); }
+  .welcome-art { width: 100%; }
+  .collection { padding: 60px 0 64px; }
+  .closing-note { min-height: 140px; }
+  .closing-note p { font-size: 24px; }
+}
+
+@media (max-width: 560px) {
+  .page-shell { width: calc(100% - 40px); }
+  .site-header { height: 72px; }
+  .wordmark { gap: 8px; }
+  .wordmark-mark { width: 32px; height: 32px; }
+  .wordmark-name { font-size: 12px; }
+  .header-tools { gap: 0; }
+  .quiet-button, .theme-button { min-height: 44px; padding: 8px; gap: 4px; }
+  .welcome { display: block; padding: 48px 0 56px; }
+  .welcome-copy { max-width: 100%; }
+  .welcome .eyebrow { margin-bottom: 20px; }
+  .welcome h1 { max-width: 12ch; font-size: clamp(40px, 11vw, 52px); line-height: 1.34; }
+  .intro { max-width: 38ch; margin-top: 20px; }
+  .welcome-art { position: relative; width: 112px; right: auto; bottom: auto; margin: 0 0 0 auto; opacity: .78; }
+  .welcome-art::before, .welcome-art::after { display: none; }
+  .scroll-cue { position: relative; z-index: 2; margin-top: 20px; }
+  .collection { padding: 48px 0 52px; }
+  .section-heading { display: flex; align-items: start; margin-bottom: 24px; }
+  .section-heading h2 { font-size: 32px; }
+  .collection-note { max-width: 124px; margin: 20px 0 0; font-size: 12px; text-align: right; }
+  .room-grid { grid-template-columns: minmax(0, 1fr); }
+  .room-card { min-height: 172px; }
+  .room-card:nth-child(odd) { border-right: 0; }
+  .room-card:nth-child(even) .room-link, .room-card:nth-child(even) .room-coming { padding-left: 0; }
+  .room-link, .room-coming { min-height: 172px; padding: 20px 32px 20px 0; }
+  .room-title { max-width: 26ch; font-size: 24px; }
+  .room-card:nth-child(even) .room-coming::after { right: 0; }
+  .closing-note { min-height: 132px; justify-content: flex-start; padding: 24px 4px; }
+  .closing-note p { margin-left: 40px; font-size: 16px; line-height: 1.75; }
+  .closing-note p::before { top: 4px; left: -32px; font-size: 16px; }
+  .site-footer { min-height: 72px; flex-wrap: wrap; row-gap: 0; }
+  .footer-brand, .footer-year, .footer-place { font-size: 12px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    scroll-behavior: auto !important;
+    animation-duration: .01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .01ms !important;
+  }
+}
