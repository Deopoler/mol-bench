+function buildOklchCss(oklch, theme, variant = 'beam') {
+  const [rawL, rawC, rawH] = oklch;
+  const h = ((Number(rawH) || 0) % 360 + 360) % 360;
+  const c = Math.max(0.02, Math.min(0.16, Number(rawC) || 0.1));
+  const l = Number(rawL) || 0.68;
