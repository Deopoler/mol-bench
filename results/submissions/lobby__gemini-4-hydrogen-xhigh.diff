+
+      const stateAfterClick = await page.evaluate(() => ({
+        hash: location.hash,
+        route: window.__bench.state().route,
+      }));
+
+      // Also verify manual hash attempt to coming_soon room does not enter it
+      const comingId = p.rooms[0].id;
