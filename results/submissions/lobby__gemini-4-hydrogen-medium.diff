+:root {
+  --bg: #faf8f4;
+  --surface: #ffffff;
+  --surface-subtle: #f3efe6;
+  --ink: #1c1a17;
+  --ink-muted: #57524b;
+  --border: #ddd6c9;
+  --accent: #8f4f0e;
+  --accent-soft: #f5ebd9;
+  --focus-ring: #1d4ed8;
+  --shadow: 0 4px 16px rgba(28, 26, 23, 0.06);
+  --transition-ms: 280ms;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --bg: #121110;
+    --surface: #1b1917;
+    --surface-subtle: #24211e;
+    --ink: #f5f2eb;
+    --ink-muted: #b8b1a7;
+    --border: #36312c;
+    --accent: #e5a95c;
+    --accent-soft: #2c2419;
+    --focus-ring: #93c5fd;
+    --shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
+  }
+}
+
+:root[data-theme="dark"] {
+  --bg: #121110;
+  --surface: #1b1917;
+  --surface-subtle: #24211e;
+  --ink: #f5f2eb;
+  --ink-muted: #b8b1a7;
+  --border: #36312c;
+  --accent: #e5a95c;
+  --accent-soft: #2c2419;
+  --focus-ring: #93c5fd;
+  --shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  :root {
+    --transition-ms: 0.01ms;
+  }
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+*, *::before, *::after {
+  box-sizing: border-box;
+}
+
+html {
+  font-size: 16px;
+  background: var(--bg);
+  color: var(--ink);
+}
+
+body {
+  margin: 0;
+  padding: 0;
+  font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", "Segoe UI", Roboto, sans-serif;
+  font-size: 16px;
+  line-height: 1.65;
+  background: var(--bg);
+  color: var(--ink);
+  word-break: keep-all;
+  overflow-wrap: break-word;
+  overflow-x: clip;
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus-ring);
+  outline-offset: 2px;
+}
+
+.skip-link {
+  position: absolute;
+  left: -9999px;
+  top: 8px;
+  padding: 12px 16px;
+  background: var(--surface);
+  color: var(--ink);
+  border: 2px solid var(--focus-ring);
+  border-radius: 8px;
+  font-size: 14px;
+  font-weight: 600;
+  z-index: 100;
+}
+
+.skip-link:focus {
+  left: 16px;
+}
+
+.container {
+  width: 100%;
+  max-width: 1120px;
+  margin-inline: auto;
+  padding-inline: 24px;
+}
+
+/* Header */
+.site-header {
+  border-bottom: 1px solid var(--border);
+  background: var(--bg);
+}
+
+.header-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding-block: 16px;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  color: var(--ink);
+  text-decoration: none;
+  font-size: 14px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  min-height: 44px;
+  padding-inline: 4px;
+}
+
+.brand-mark {
+  width: 16px;
+  height: 16px;
+  border-radius: 999px;
+  background: radial-gradient(circle at 35% 35%, var(--accent), transparent 72%);
+  border: 2px solid var(--accent);
+  flex-shrink: 0;
+}
+
+.header-controls {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.control-btn {
+  appearance: none;
+  background: var(--surface);
+  color: var(--ink);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 8px 16px;
+  min-height: 44px;
+  min-width: 44px;
+  font-family: inherit;
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 1.4;
+  cursor: pointer;
+  transition: background var(--transition-ms) ease, border-color var(--transition-ms) ease;
+}
+
+.control-btn:hover {
+  background: var(--surface-subtle);
+  border-color: var(--accent);
+}
+
+/* Main */
+.site-main {
+  flex: 1 0 auto;
+}
+
+.view-panel {
+  opacity: 1;
+  transform: translateY(0);
+  transition: opacity var(--transition-ms) cubic-bezier(0.22, 1, 0.36, 1),
+              transform var(--transition-ms) cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+.view-panel.is-entering {
+  opacity: 0;
+  transform: translateY(8px);
+}
+
+/* Hero */
+.hero {
+  padding-block: 80px;
+  border-bottom: 1px solid var(--border);
+}
+
+.hero-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 32px;
+}
+
+.eyebrow {
+  margin: 0 0 12px 0;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--accent);
+}
+
+.hero-title {
+  margin: 0 0 16px 0;
+  font-family: "Iowan Old Style", "Palatino Linotype", Georgia, "Batang", "NanumMyeongjo", serif;
+  font-size: 40px;
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.01em;
+  max-width: 18em;
+}
+
+.hero-body {
+  margin: 0;
+  font-size: 16px;
+  line-height: 1.65;
+  color: var(--ink-muted);
+  max-width: 34rem;
+}
+
+.hero-motif {
+  width: 160px;
+  height: 160px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.aperture {
+  position: relative;
+  width: 144px;
+  height: 144px;
+  border-radius: 999px;
+  background: radial-gradient(circle at 42% 40%, var(--accent-soft) 0%, transparent 72%);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.aperture-ring {
+  width: 96px;
+  height: 96px;
+  border-radius: 999px;
+  border: 1px solid var(--border);
+}
+
+.aperture-core {
+  position: absolute;
+  width: 24px;
+  height: 24px;
+  border-radius: 999px;
+  background: var(--accent);
+  opacity: 0.55;
+}
+
+/* Rooms Section */
+.rooms-section {
+  padding-block: 64px;
+  border-bottom: 1px solid var(--border);
+}
+
+.section-head {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 8px;
+  margin-bottom: 32px;
+}
+
+.section-title {
+  margin: 0;
+  font-size: 24px;
+  font-weight: 700;
+  line-height: 1.35;
+}
+
+.section-count {
+  margin: 0;
+  font-size: 14px;
+  color: var(--ink-muted);
+}
+
+.rooms-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 32px 24px;
+}
+
+.room-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  background: transparent;
+  border-top: 2px solid var(--border);
+  overflow: visible;
+  transition: transform var(--transition-ms) ease, border-color var(--transition-ms) ease;
+}
+
+.room-card[data-status="open"]:hover {
+  transform: translateY(-2px);
+  border-top-color: var(--accent);
+}
+
+.room-card__link {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  padding: 16px 0 16px 0;
+  gap: 12px;
+  text-decoration: none;
+  color: inherit;
+}
+
+.room-card--soon {
+  padding: 16px 0 16px 0;
+  gap: 12px;
+  border-top-style: dashed;
+  opacity: 0.72;
+}
+
+.room-card__meta {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.room-card__dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 999px;
+  background: var(--room-accent, var(--accent));
+  flex-shrink: 0;
+}
+
+.room-card__index {
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  color: var(--ink-muted);
+  margin-right: 8px;
+}
+
+.room-card__badge {
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--ink-muted);
+}
+
+.room-card__badge--open {
+  color: var(--accent);
+}
+
+.room-card__title {
+  margin: 0;
+  font-size: 16px;
+  font-weight: 700;
+  line-height: 1.5;
+  color: var(--ink);
+}
+
+.room-card__summary {
+  margin: 0;
+  font-size: 14px;
+  line-height: 1.6;
+  color: var(--ink-muted);
+  flex: 1 1 auto;
+}
+
+.room-card__cta {
+  margin-top: 4px;
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--accent);
+}
+
+/* Empty State */
+.empty-state {
+  padding: 48px 24px;
+  text-align: center;
+  background: var(--surface);
+  border: 1px dashed var(--border);
+  border-radius: 12px;
+}
+
+.empty-title {
+  margin: 0 0 12px 0;
+  font-size: 24px;
+  font-weight: 700;
+}
+
+.empty-body {
+  margin: 0 auto;
+  font-size: 16px;
+  line-height: 1.65;
+  color: var(--ink-muted);
+  max-width: 34rem;
+}
+
+/* Info Section */
+.info-section {
+  padding-block: 64px;
+}
+
+.info-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
+  gap: 32px;
+  align-items: start;
+}
+
+.info-block .section-title {
+  margin-bottom: 16px;
+}
+
+.info-body {
+  margin: 0;
+  font-size: 16px;
+  line-height: 1.65;
+  color: var(--ink-muted);
+  max-width: 34rem;
+}
+
+.info-meta {
+  margin: 0;
+  padding: 24px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.info-meta-row {
+  display: grid;
+  grid-template-columns: 96px minmax(0, 1fr);
+  gap: 16px;
+  font-size: 14px;
+}
+
+.info-meta dt {
+  font-weight: 600;
+  color: var(--ink-muted);
+}
+
+.info-meta dd {
+  margin: 0;
+  font-weight: 600;
+  color: var(--ink);
+  text-align: left;
+}
+
+/* Room Detail View */
+.room-view {
+  padding-block: 48px;
+}
+
+.room-detail {
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+}
+
+.back-link {
+  display: inline-flex;
+  align-items: center;
+  align-self: flex-start;
+  min-height: 44px;
+  padding: 8px 16px;
+  border-radius: 8px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  color: var(--ink);
+  text-decoration: none;
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.back-link:hover {
+  border-color: var(--accent);
+}
+
+.room-detail-card {
+  padding: 32px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  box-shadow: var(--shadow);
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+
+.room-detail-swatch {
+  height: 8px;
+  width: 96px;
+  border-radius: 4px;
+  background: var(--room-accent, var(--accent));
+}
+
+.room-detail-title {
+  margin: 0;
+  font-size: 24px;
+  font-weight: 700;
+  line-height: 1.35;
+}
+
+.room-detail-body,
+.room-detail-note {
+  margin: 0;
+  font-size: 16px;
+  line-height: 1.65;
+  color: var(--ink-muted);
+  max-width: 34rem;
+}
+
+/* Footer */
+.site-footer {
+  border-top: 1px solid var(--border);
+  padding-block: 24px;
+  background: var(--bg);
+}
+
+.footer-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.footer-brand {
+  margin: 0;
+  font-size: 12px;
+  color: var(--ink-muted);
+}
+
+.footer-links {
+  display: block;
+}
+
+.footer-links a {
+  display: inline-block;
+  line-height: 44px;
+  padding-inline: 8px;
+  margin-left: 8px;
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--ink-muted);
+  text-decoration: none;
+}
+
+.footer-links a:hover {
+  color: var(--ink);
+}
+
+/* Responsive */
+@media (max-width: 1023px) {
+  .rooms-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .info-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 639px) {
+  .container {
+    padding-inline: 16px;
+  }
+  .hero {
+    padding-block: 32px;
+  }
+  .hero-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .hero-motif {
+    display: none;
+  }
+  .hero-title {
+    font-size: 32px;
+  }
+  .rooms-section,
+  .info-section,
+  .room-view {
+    padding-block: 32px;
+  }
+  .rooms-grid {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 16px;
+  }
+}
diff --git a/tests/lobby.test.mjs b/tests/lobby.test.mjs
new file mode 100644
index 0000000..23913e2
--- /dev/null
+++ b/tests/lobby.test.mjs
@@ -0,0 +1,124 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import { chromium } from 'playwright-core';
+
+const LOBBY_DIR = path.resolve('lobby');
+
+function startStaticServer() {
+  const mimeTypes = {
+    '.html': 'text/html; charset=utf-8',
+    '.js': 'text/javascript; charset=utf-8',
+    '.css': 'text/css; charset=utf-8',
+    '.json': 'application/json; charset=utf-8',
+  };
+  const server = http.createServer((req, res) => {
+    const reqPath = (req.url || '/').split('?')[0];
+    const rel = reqPath === '/' || reqPath === '/lobby/' ? 'index.html' : reqPath.replace(/^\/lobby\//, '').replace(/^\/+/, '');
+    const filePath = path.join(LOBBY_DIR, rel);
+    if (!filePath.startsWith(LOBBY_DIR) || !fs.existsSync(filePath)) {
+      res.writeHead(404);
+      res.end('Not found');
+      return;
+    }
+    const ext = path.extname(filePath);
+    res.writeHead(200, { 'Content-Type': mimeTypes[ext] || 'application/octet-stream' });
+    fs.createReadStream(filePath).pipe(res);
+  });
+  return new Promise((resolve) => {
+    server.listen(0, '127.0.0.1', () => {
+      const addr = server.address();
+      resolve({ server, url: `http://127.0.0.1:${addr.port}/index.html` });
+    });
+  });
+}
+
+function injectHost(rooms) {
+  window.__benchHost = {
+    contractVersion: 1,
+    seed: 1,
+    params: { rooms },
+    clock: { now: () => 0 },
+    rng: { next: () => 0.5, int: (n) => 0, fork: () => window.__benchHost.rng },
+  };
+}
+
+const SAMPLE_ROOMS = [
+  {
+    id: 'room-1',
+    route: '#/room/room-1',
+    title_ko: '고요한 빛의 정원',
+    title_en: 'A Garden of Quiet Light',
+    summary_ko: '빛과 기억이 포개지는 작은 전시를 천천히 거닐어 보세요.',
+    accent_oklch: [0.68, 0.12, 155],
+    status: 'open',
+  },
+  {
+    id: 'room-2',
+    route: '#/room/room-2',
+    title_ko: '기억을 수집하는 방',
+    title_en: 'Rooms That Gather Memory',
+    summary_ko: '조용한 관찰과 발견을 위한 공간입니다.',
+    accent_oklch: [0.68, 0.12, 220],
+    status: 'coming_soon',
+  },
+];
+
+test('lobby renders rooms, handles coming_soon, empty state, language, theme, and routes', async () => {
+  const { server, url } = await startStaticServer();
+  const localChrome = path.resolve('node_modules/playwright-core/.local-browsers/chromium-1194/chrome-win/chrome.exe');
+  const launchOpts = fs.existsSync(localChrome) ? { executablePath: localChrome } : {};
+  const browser = await chromium.launch(launchOpts);
+  try {
+    const context = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+    const page = await context.newPage();
+    await page.addInitScript(injectHost, SAMPLE_ROOMS);
+    await page.goto(url, { waitUntil: 'networkidle' });
+    await page.evaluate(() => window.__bench.ready);
+
+    // Landmarks
+    for (const landmark of ['header', 'hero-title', 'body', 'footer', 'empty-state']) {
+      assert.ok(await page.locator(`[data-bench="${landmark}"]`).count() >= 1, `missing ${landmark}`);
+    }
+
+    // Room cards & coming_soon distinction
+    const cards = page.locator('[data-bench="room-card"]');
+    assert.equal(await cards.count(), 2);
+    assert.equal(await cards.nth(0).locator('a[href="#/room/room-1"]').count(), 1);
+    assert.equal(await cards.nth(1).locator('a[href]').count(), 0);
+    assert.equal(await cards.nth(1).getAttribute('data-status'), 'coming_soon');
+
+    // Empty state hidden when rooms exist
+    assert.equal(await page.locator('[data-bench="empty-state"]').isHidden(), true);
+
+    // Language toggle switches to English titles
+    await page.locator('[data-bench="lang-toggle"]').click();
+    assert.equal(await page.evaluate(() => window.__bench.state().lang), 'en');
+    assert.equal(await cards.nth(0).locator('h3').textContent(), 'A Garden of Quiet Light');
+
+    // Theme toggle switches theme
+    const themeBefore = await page.evaluate(() => window.__bench.state().theme);
+    await page.locator('[data-bench="theme-toggle"]').click();
+    const themeAfter = await page.evaluate(() => window.__bench.state().theme);
+    assert.notEqual(themeBefore, themeAfter);
+
+    // Navigation to open room and back
+    await cards.nth(0).locator('a').click();
+    assert.equal(await page.evaluate(() => window.__bench.state().route), 'room-1');
+    await page.goBack();
+    assert.equal(await page.evaluate(() => window.__bench.state().route), 'lobby');
+
+    // Empty collection state
+    const pageEmpty = await context.newPage();
+    await pageEmpty.addInitScript(injectHost, []);
+    await pageEmpty.goto(url, { waitUntil: 'networkidle' });
+    await pageEmpty.evaluate(() => window.__bench.ready);
+    assert.equal(await pageEmpty.locator('[data-bench="room-card"]').count(), 0);
+    assert.equal(await pageEmpty.locator('[data-bench="empty-state"]').isVisible(), true);
+  } finally {
+    await browser.close();
+    server.close();
+  }
+});
