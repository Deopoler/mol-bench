diff --git a/lobby/styles.css b/lobby/styles.css
new file mode 100644
index 0000000..bbfe8fe
--- /dev/null
+++ b/lobby/styles.css
@@ -0,0 +1,258 @@
+:root {
+  color-scheme: light;
+  --bg: oklch(97.5% 0.008 85);
+  --surface: oklch(100% 0 0);
+  --ink: oklch(24% 0.02 260);
+  --muted: oklch(40% 0.02 260);
+  --line: oklch(82% 0.012 260);
+  --focus: oklch(42% 0.16 262);
+  --sans: system-ui, -apple-system, "Segoe UI", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
+  --serif: "Batang", "Noto Serif KR", Georgia, serif;
+  --fs-xs: 14px;
+  --fs-sm: 16px;
+  --fs-md: 20px;
+  --fs-lg: 32px;
+  --fs-xl: 40px;
+}
+
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --bg: oklch(18% 0.014 260);
+  --surface: oklch(23% 0.016 260);
+  --ink: oklch(94% 0.01 85);
+  --muted: oklch(76% 0.016 260);
+  --line: oklch(38% 0.016 260);
+  --focus: oklch(80% 0.12 262);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    color-scheme: dark;
+    --bg: oklch(18% 0.014 260);
+    --surface: oklch(23% 0.016 260);
+    --ink: oklch(94% 0.01 85);
+    --muted: oklch(76% 0.016 260);
+    --line: oklch(38% 0.016 260);
+    --focus: oklch(80% 0.12 262);
+  }
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+[hidden] { display: none !important; }
+
+html { -webkit-text-size-adjust: 100%; }
+html:lang(ko) body { line-height: 1.7; word-break: keep-all; }
+html:lang(en) body { line-height: 1.6; }
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  background: var(--bg);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: var(--fs-sm);
+  overflow-wrap: break-word;
+}
+
+main { flex: 1 0 auto; width: 100%; }
+
+.wrap { max-width: 1120px; margin-inline: auto; padding-inline: 16px; }
+@media (min-width: 640px) { .wrap { padding-inline: 24px; } }
+
+:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
+h1[tabindex="-1"]:focus { outline: none; }
+
+/* Header */
+.site-header { border-bottom: 1px solid var(--line); }
+.bar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding-block: 16px;
+}
+.brand {
+  margin: 0;
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.controls { display: flex; gap: 8px; }
+
+.btn {
+  font: inherit;
+  font-size: var(--fs-xs);
+  min-height: 44px;
+  min-width: 44px;
+  padding: 8px 16px;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: var(--surface);
+  color: var(--ink);
+  text-decoration: none;
+  display: inline-flex;
+  align-items: center;
+  cursor: pointer;
+}
+.btn:hover { border-color: var(--ink); }
+
+/* Hero */
+.hero { padding-block: 64px 48px; }
+h1 {
+  font-family: var(--serif);
+  font-size: var(--fs-lg);
+  font-weight: 600;
+  line-height: 1.3;
+  margin: 0 0 24px;
+  max-width: 20em;
+  overflow-wrap: anywhere;
+}
+@media (min-width: 640px) { h1 { font-size: var(--fs-xl); } }
+
+.lead, .body {
+  margin: 0;
+  max-width: 30em;
+}
+.lead { font-size: var(--fs-md); color: var(--muted); }
+.body { font-size: var(--fs-sm); max-width: 34em; }
+:lang(en) .lead { max-width: 40em; }
+:lang(en) .body { max-width: 40em; }
+
+/* Rooms */
+.rooms-section { padding-block: 48px; }
+h2 {
+  font-family: var(--serif);
+  font-size: var(--fs-lg);
+  font-weight: 600;
+  line-height: 1.3;
+  margin: 0 0 24px;
+}
+.rooms {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
+  gap: 24px;
+}
+.rooms > li { min-width: 0; }
+
+.room-card {
+  position: relative;
+  height: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 24px;
+  background: var(--surface);
+  border-radius: 12px;
+}
+.room-card:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 4px; }
+
+.card-meta {
+  margin: 0;
+  font-size: var(--fs-xs);
+  color: var(--muted);
+  letter-spacing: 0.04em;
+}
+.card-meta::before {
+  content: "";
+  display: inline-block;
+  width: 8px;
+  height: 8px;
+  margin-right: 8px;
+  border-radius: 50%;
+  background: var(--accent, var(--focus));
+  vertical-align: middle;
+}
+.room-card.is-soon .card-meta::before { background: transparent; border: 1px dashed var(--muted); }
+.room-card h3 {
+  margin: 0;
+  font-size: var(--fs-md);
+  font-weight: 600;
+  line-height: 1.35;
+  overflow-wrap: anywhere;
+}
+.room-card h3 a { color: inherit; text-decoration: none; }
+.room-card h3 a::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: 12px;
+}
+
+.badge {
+  display: inline-block;
+  padding: 4px 8px;
+  border: 1px dashed var(--muted);
+  border-radius: 999px;
+}
+
+.room-card.is-soon {
+  background: transparent;
+  border: 1px dashed var(--line);
+  color: var(--muted);
+}
+
+.empty {
+  margin: 0;
+  padding: 32px 24px;
+  border: 1px dashed var(--line);
+  border-radius: 12px;
+  color: var(--muted);
+  text-align: center;
+}
+
+/* Info */
+.info {
+  padding-block: 48px;
+  border-top: 1px solid var(--line);
+}
+
+/* Room view */
+.room { padding-block: 48px; }
+.room .btn { margin-bottom: 32px; }
+.swatch {
+  display: block;
+  width: 64px;
+  height: 8px;
+  margin-block: 24px;
+  border-radius: 999px;
+  background: var(--accent, var(--focus));
+}
+.note {
+  margin: 24px 0 0;
+  font-size: var(--fs-xs);
+  color: var(--muted);
+}
+
+/* Footer */
+.site-footer {
+  border-top: 1px solid var(--line);
+  padding-block: 24px;
+  font-size: var(--fs-xs);
+  color: var(--muted);
+}
+
+/* Navigation transition (route change). Motion only moves the view; content is never hidden
+   at the start frame, so a frozen or sampled frame still shows the page. */
+#lobby:not([hidden]), #room:not([hidden]) {
+  animation: view-in 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
+}
+@keyframes view-in {
+  from { transform: translateY(8px); }
+  to { transform: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
