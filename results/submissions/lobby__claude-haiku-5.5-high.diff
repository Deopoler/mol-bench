+</main>
+<footer data-bench="footer" class="site-footer">
+  <p lang="en">Museum of Light · Seoul</p>
+  <a href="#/" data-i18n="footerLink">입구로 돌아가기</a>
+</footer>
+<script src="./app.js" defer></script>
+</body>
+</html>
