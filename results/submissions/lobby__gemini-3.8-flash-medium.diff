+});
+
+// Initial Setup
+const savedTheme = (typeof localStorage !== 'undefined' && localStorage.getItem('mol-theme')) || null;
+if (savedTheme) {
+  document.documentElement.dataset.theme = savedTheme;
+}
+updateStaticText();
+renderRooms();
+updateRouteView();
+
+// Bench Runtime Contract (contract/bench.d.ts)
