+  }
+
+  .collection {
+    padding-top: var(--sp-12);
+    padding-bottom: var(--sp-12);
+  }
+
+  .rooms-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: var(--sp-5);
+  }
+
+  .guide-grid {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--sp-8);
+  }
+
+  .guide-editorial {
+    grid-column: span 1;
+  }
+
+  .stage-frame {
+    grid-template-columns: minmax(0, 1fr);
+    padding: var(--sp-6);
+  }
+
+  .stage-field {
+    min-height: 220px;
+  }
+}
+
+/* Phone breakpoint (360x780) */
+@media (max-width: 639px) {
+  :root {
+    --shell-pad: 20px;
+    --fs-section: 24px;
+    --fs-hero: 32px;
+  }
