@@ -0,0 +1,978 @@
+/* Museum of Light — Lobby
+ * Disciplined 4px spacing grid, 5-step type scale, dual light/dark tokens.
+ */
+
+:root {
+  /* Local system font stacks — Georgia for Latin serif, Batang/Myungjo for Hangul serif */
+  --font-serif: Georgia, "Batang", "KoPubBatang", "AppleMyungjo", "NanumMyeongjo", "Noto Serif KR", "Times New Roman", serif;
+  --font-sans: "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, -apple-system, "Segoe UI", sans-serif;
+
+  /* 5-step modular type scale (min step ratio >= 1.20 across viewports) */
+  --fs-meta: 13px;
+  --fs-body: 16px;
+  --fs-card: 20px;
+  --fs-section: 28px;
+  --fs-hero: 48px;
+
+  /* Strict 4px spacing tokens */
+  --sp-1: 4px;
+  --sp-2: 8px;
+  --sp-3: 12px;
+  --sp-4: 16px;
+  --sp-5: 20px;
+  --sp-6: 24px;
+  --sp-8: 32px;
+  --sp-10: 40px;
+  --sp-12: 48px;
+  --sp-16: 64px;
+  --sp-20: 80px;
+  --sp-24: 96px;
+  --sp-28: 112px;
+
+  --shell-pad: 40px;
+  --body-lh: 28px; /* 1.75 for Hangul [1.5, 1.9] */
+
+  /* Light theme — calm warm museum limestone */
+  --bg: #F6F3EC;
+  --bg-elevated: #FAF7F1;
+  --bg-muted: #EEEAE0;
+  --bg-stage: #E6DFD0;
+  --ink: #262420;
+  --ink-secondary: #524E47;
+  --ink-muted: #5E5950;
+  --border: #E2DBCD;
+  --border-strong: #BDB3A0;
+  --accent: #8A5126;
+  --focus-ring: #142D55;
+  --aperture-core: #DFB574;
+  --aperture-glow: #CEA161;
+  --card-wash-l: 0.94;
+  --card-bar-l: 0.70;
+  --card-wash-c-scale: 0.34;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --bg: #121210;
+    --bg-elevated: #1A1A17;
+    --bg-muted: #151512;
+    --bg-stage: #0B0B0A;
+    --ink: #F2EEE6;
+    --ink-secondary: #C2BCB0;
+    --ink-muted: #A6A094;
+    --border: #2C2B25;
+    --border-strong: #4F4C42;
+    --accent: #DAA96E;
+    --focus-ring: #F4D078;
+    --aperture-core: #D9AC69;
+    --aperture-glow: #A97D42;
+    --card-wash-l: 0.22;
+    --card-bar-l: 0.72;
+    --card-wash-c-scale: 0.36;
+  }
+}
+
+:root[data-theme="dark"] {
+  --bg: #121210;
+  --bg-elevated: #1A1A17;
+  --bg-muted: #151512;
+  --bg-stage: #0B0B0A;
+  --ink: #F2EEE6;
+  --ink-secondary: #C2BCB0;
+  --ink-muted: #A6A094;
+  --border: #2C2B25;
+  --border-strong: #4F4C42;
+  --accent: #DAA96E;
+  --focus-ring: #F4D078;
+  --aperture-core: #D9AC69;
+  --aperture-glow: #A97D42;
+  --card-wash-l: 0.22;
+  --card-bar-l: 0.72;
+  --card-wash-c-scale: 0.36;
+}
+
+:root[lang="en"] {
+  --body-lh: 26px; /* 1.625 for Latin [1.4, 1.8] */
+}
+
+/* Reset */
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+  margin: 0;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html {
+  background-color: var(--bg);
+  color: var(--ink);
+  font-family: var(--font-sans);
+  font-size: var(--fs-body);
+  line-height: var(--body-lh);
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  min-height: 100vh;
+  background-color: var(--bg);
+  color: var(--ink);
+  font-family: var(--font-sans);
+  font-size: var(--fs-body);
+  line-height: var(--body-lh);
+  overflow-x: clip;
+  word-break: keep-all;
+  overflow-wrap: break-word;
+}
+
+button,
+a {
+  font-family: inherit;
+  color: inherit;
+}
+
+button {
+  background: none;
+  border: 0;
+  cursor: pointer;
+}
+
+/* High-contrast 3px solid focus indicator (fits inside 8px clip pad) */
+a:focus-visible,
+button:focus-visible,
+[tabindex]:focus-visible {
+  outline: 3px solid var(--focus-ring);
+  outline-offset: 2px;
+}
+
+.skip-link {
+  position: absolute;
+  left: -9999px;
+  top: var(--sp-2);
+  z-index: 100;
+  background: var(--ink);
+  color: var(--bg);
+  font-size: var(--fs-meta);
+  line-height: 20px;
+  padding: var(--sp-3) var(--sp-4);
+  text-decoration: none;
+}
+
+.skip-link:focus-visible {
+  left: var(--sp-4);
+  outline: 3px solid var(--focus-ring);
+  outline-offset: 2px;
+}
+
+/* Layout shell */
+.shell {
+  width: 100%;
+  max-width: 1200px;
+  margin-inline: auto;
+  padding-inline: var(--shell-pad);
+}
+
+/* Site Header */
+.site-header {
+  border-bottom: 1px solid var(--border);
+  background-color: var(--bg);
+}
+
+.header-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-4);
+  padding-block: var(--sp-5);
+}
+
+.brand {
+  display: inline-block;
+  min-height: 44px;
+  padding-block: var(--sp-2);
+  padding-inline: var(--sp-1);
+  text-decoration: none;
+  color: var(--ink);
+  font-size: var(--fs-body);
+  font-weight: 600;
+  line-height: 28px;
+  letter-spacing: 0.08em;
+}
+
+.brand-mark {
+  display: inline-block;
+  width: 12px;
+  height: 12px;
+  margin-right: var(--sp-3);
+  vertical-align: middle;
+  background-color: var(--accent);
+}
+
+.brand-wordmark {
+  font-size: var(--fs-body);
+  line-height: 28px;
+  vertical-align: middle;
+}
+
+.header-controls {
+  display: block;
+  flex: 0 0 auto;
+  white-space: nowrap;
+}
+
+.control-btn {
+  display: inline-block;
+  min-width: 44px;
+  min-height: 44px;
+  padding: var(--sp-2) var(--sp-4);
+  border: 1px solid transparent;
+  background-color: transparent;
+  color: var(--ink-secondary);
+  font-size: var(--fs-meta);
+  font-weight: 600;
+  line-height: 28px;
+  letter-spacing: 0.03em;
+  text-align: center;
+  white-space: nowrap;
+  vertical-align: middle;
+}
+
+.control-btn + .control-btn {
+  margin-left: var(--sp-2);
+}
+
+.control-btn:hover {
+  color: var(--ink);
+  border-color: var(--border);
+  background-color: var(--bg-elevated);
+}
+
+.theme-icon {
+  display: inline-block;
+  vertical-align: middle;
+  margin-right: var(--sp-2);
+}
+
+.control-label {
+  font-size: var(--fs-meta);
+  line-height: 28px;
+  vertical-align: middle;
+}
+
+/* Hero Section — generous museum foyer proportions */
+.hero {
+  padding-top: var(--sp-28);
+  padding-bottom: var(--sp-28);
+  border-bottom: 1px solid var(--border);
+}
+
+.hero-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 320px;
+  align-items: center;
+  gap: var(--sp-12);
+}
+
+.hero-copy {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-5);
+  min-width: 0;
+}
+
+.eyebrow {
+  font-size: var(--fs-meta);
+  font-weight: 600;
+  line-height: 20px;
+  letter-spacing: 0.08em;
+  color: var(--ink-muted);
+}
+
+.hero-title {
+  font-family: var(--font-serif);
