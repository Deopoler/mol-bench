@@ -0,0 +1,673 @@
+/* Museum of Light — Lobby Editorial Stylesheet */
+
+:root {
+  color-scheme: light dark;
+
+  /* Light palette: calm gallery limestone & warm archival paper */
+  --bg: #f6f4ef;
+  --bg-elevated: #faf9f5;
+  --bg-subtle: #efece4;
+  --ink: #262420;
+  --ink-secondary: #504d47;
+  --ink-muted: #5d5952;
+  --border: #e8e4db;
+  --border-strong: #cec8bc;
+  --focus-ring: #1146b8;
+  --status-open: #275a3c;
+  --status-soon: #5d5952;
+
+  /* Typography — local/system stacks only (no network font requests) */
+  --font-serif: Georgia, "Batang", "AppleMyungjo", "Noto Serif KR", "Times New Roman", serif;
+  --font-sans: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+
+  /* Strict 5-step modular type scale (min ratio = 16/14 = 1.143 > 1.125) */
+  --fs-sm: 14px;
+  --fs-base: 16px;
+  --fs-lg: 20px;
+  --fs-xl: 28px;
+  --fs-hero: 48px;
+
+  /* 4px spacing rhythm */
+  --sp-1: 4px;
+  --sp-2: 8px;
+  --sp-3: 12px;
+  --sp-4: 16px;
+  --sp-5: 20px;
+  --sp-6: 24px;
+  --sp-8: 32px;
+  --sp-10: 40px;
+  --sp-12: 48px;
+  --sp-16: 64px;
+  --sp-20: 80px;
+  --sp-24: 96px;
+
+  /* Motion */
+  --nav-duration: 320ms;
+  --nav-ease: cubic-bezier(0.2, 0.6, 0.4, 1);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --bg: #141311;
+    --bg-elevated: #1b1a17;
+    --bg-subtle: #23211d;
+    --ink: #efece4;
+    --ink-secondary: #c7c2b7;
+    --ink-muted: #a6a094;
+    --border: #2c2a25;
+    --border-strong: #49453d;
+    --focus-ring: #8bb8ff;
+    --status-open: #9ad8b0;
+    --status-soon: #b6b0a4;
+  }
+}
+
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --bg: #141311;
+  --bg-elevated: #1b1a17;
+  --bg-subtle: #23211d;
+  --ink: #efece4;
+  --ink-secondary: #c7c2b7;
+  --ink-muted: #a6a094;
+  --border: #2c2a25;
+  --border-strong: #49453d;
+  --focus-ring: #8bb8ff;
+  --status-open: #9ad8b0;
+  --status-soon: #b6b0a4;
+}
+
+:root[data-theme="light"] {
+  color-scheme: light;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  background-color: var(--bg);
+  color: var(--ink);
+  font-family: var(--font-sans);
+  font-size: var(--fs-base);
+  line-height: 28px;
+  word-break: keep-all;
+  overflow-wrap: break-word;
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  padding: 0;
+  background-color: var(--bg);
+  color: var(--ink);
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+h1, h2, h3, p {
+  margin: 0;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+button {
+  font-family: inherit;
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  cursor: pointer;
+}
+
+/* Strong, accessible 3px focus ring (>= 3:1 contrast, > 2 * perimeter pixels) */
+:focus-visible {
+  outline: 3px solid var(--focus-ring);
+  outline-offset: 2px;
+}
+
+/* Container */
+.container {
+  width: 100%;
+  max-width: 1080px;
+  margin-inline: auto;
+  padding-inline: var(--sp-6);
+}
+
+/* Header */
+.site-header {
+  border-bottom: 1px solid var(--border);
+  background-color: var(--bg);
+}
+
+.header-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-4);
+  padding-block: var(--sp-5);
+}
+
+.brand {
+  display: block;
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  color: var(--ink);
+}
+
+.brand-mark {
+  display: inline-block;
+  width: 8px;
+  height: 8px;
+  margin-right: var(--sp-3);
+  border-radius: 2px;
+  background-color: var(--ink);
+  vertical-align: middle;
+}
+
+.brand-name {
+  vertical-align: middle;
+}
+
+.header-controls {
+  display: block;
+  white-space: nowrap;
+}
+
+.control-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 44px;
+  min-height: 44px;
+  padding: var(--sp-2) var(--sp-4);
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  background-color: var(--bg);
+  color: var(--ink);
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  font-weight: 500;
+  transition: background-color 160ms ease, border-color 160ms ease;
+}
+
+.control-btn + .control-btn {
+  margin-left: var(--sp-2);
+}
+
+.control-btn:hover {
+  background-color: var(--bg-subtle);
+  border-color: var(--border-strong);
+}
+
+/* Main */
+.site-main {
+  flex: 1 0 auto;
+}
+
+/* Hero — generous museum entrance stillness */
+.hero {
+  padding-top: 160px;
+  padding-bottom: 144px;
+}
+
+.eyebrow {
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  letter-spacing: 0.12em;
+  color: var(--ink-muted);
+  margin-bottom: var(--sp-6);
+}
+
+.hero-title {
+  font-family: var(--font-serif);
+  font-size: var(--fs-hero);
+  line-height: 60px;
+  font-weight: 400;
+  letter-spacing: -0.02em;
+  color: var(--ink);
+  max-width: 720px;
+  margin-bottom: var(--sp-8);
+}
+
+.body-copy {
+  font-size: var(--fs-base);
+  line-height: 28px;
+  color: var(--ink-secondary);
+  max-width: 576px;
+}
+
+/* Collection section */
+.collection {
+  padding-top: var(--sp-8);
+  padding-bottom: var(--sp-20);
+}
+
+.section-header {
+  display: block;
+  margin-bottom: var(--sp-8);
+}
+
+.section-title {
+  font-family: var(--font-serif);
+  font-size: var(--fs-xl);
+  line-height: 36px;
+  font-weight: 400;
+  color: var(--ink);
+  margin-bottom: var(--sp-2);
+}
+
+.section-meta {
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  color: var(--ink-muted);
+}
+
+/* Rooms grid */
+.rooms-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--sp-8);
+}
+
+/* Room card — restrained gallery plate */
+.room-card {
+  display: flex;
+  flex-direction: column;
+  border-radius: 4px;
+  background-color: var(--bg-elevated);
+  border: 1px solid var(--border);
+  transition: transform 200ms var(--nav-ease), border-color 200ms ease;
+}
+
+.room-card[data-status="open"]:hover {
+  transform: translateY(-2px);
+  border-color: var(--border-strong);
+}
+
+.room-card-link {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  border-radius: 4px;
+  color: inherit;
+  min-height: 44px;
+}
+
+.room-card-link:focus-visible {
+  outline: 3px solid var(--focus-ring);
+  outline-offset: 2px;
+}
+
+.room-accent-bar {
+  height: 4px;
+  width: 48px;
+  border-radius: 2px;
+  background-color: var(--card-accent, var(--ink-muted));
+  flex-shrink: 0;
+}
+
+.room-card-body {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  padding: var(--sp-8);
+  gap: var(--sp-4);
+}
+
+.room-meta {
+  display: block;
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  color: var(--ink-muted);
+}
+
+.room-index {
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  margin-right: var(--sp-3);
+}
+
+.room-status {
+  font-weight: 500;
+  color: var(--status-open);
+}
+
+.room-title {
+  font-family: var(--font-serif);
+  font-size: var(--fs-lg);
+  line-height: 28px;
+  font-weight: 600;
+  color: var(--ink);
+}
+
+.room-summary {
+  font-size: var(--fs-base);
+  line-height: 28px;
+  color: var(--ink-secondary);
+  flex: 1 1 auto;
+}
+
+.room-cta {
+  padding-top: var(--sp-2);
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  font-weight: 500;
+  color: var(--ink);
+}
+
+/* Coming-soon room card: visibly distinct, non-navigable */
+.room-card--coming-soon {
+  background-color: var(--bg-subtle);
+  border-style: dashed;
+  border-color: var(--border-strong);
+}
+
+.room-card--coming-soon .room-accent-bar {
+  background-color: var(--border-strong);
+}
+
+.room-card--coming-soon .room-status {
+  color: var(--status-soon);
+}
+
+.room-card--coming-soon .room-title {
+  color: var(--ink-secondary);
+}
+
+.room-card--coming-soon .room-cta {
+  color: var(--ink-muted);
+}
+
+/* Empty state */
+.empty-state {
+  padding: var(--sp-12) var(--sp-8);
+  border: 1px dashed var(--border-strong);
+  border-radius: 4px;
+  background-color: var(--bg-subtle);
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-3);
+}
+
+.empty-state[hidden] {
+  display: none;
+}
+
+.empty-title {
+  font-family: var(--font-serif);
+  font-size: var(--fs-lg);
+  line-height: 28px;
+  font-weight: 600;
+  color: var(--ink);
+}
+
+.empty-desc {
+  font-size: var(--fs-base);
+  line-height: 28px;
+  color: var(--ink-secondary);
+  max-width: 576px;
+}
+
+/* Visitor info section */
+.visitor-info {
+  border-top: 1px solid var(--border);
+  background-color: var(--bg-subtle);
+  padding-block: var(--sp-16);
+}
+
+.info-intro {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-4);
+  margin-bottom: var(--sp-10);
+}
+
+.info-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--sp-8);
+}
+
+.info-item {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-2);
+  padding: var(--sp-8);
+  border-radius: 4px;
+  background-color: var(--bg-elevated);
+  border: 1px solid var(--border);
+}
+
+.info-label {
+  font-size: var(--fs-lg);
+  line-height: 28px;
+  font-weight: 600;
+  color: var(--ink);
+}
+
+.info-text {
+  font-size: var(--fs-base);
+  line-height: 28px;
+  color: var(--ink-secondary);
+}
+
+/* Footer */
+.site-footer {
+  border-top: 1px solid var(--border);
+  background-color: var(--bg);
+}
+
+.footer-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-4);
+  padding-block: var(--sp-6);
+}
+
+.footer-brand {
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  color: var(--ink-muted);
+}
+
+.footer-nav {
+  display: block;
+}
+
+.footer-link {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: var(--sp-2) var(--sp-3);
+  border-radius: 4px;
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  color: var(--ink-secondary);
+}
+
+.footer-link + .footer-link {
+  margin-left: var(--sp-2);
+}
+
+.footer-link:hover {
+  color: var(--ink);
+  background-color: var(--bg-subtle);
+}
+
+/* Room view overlay — preserves lobby scroll position and provides deterministic nav transition */
+.room-view {
+  position: fixed;
+  inset: 0;
+  z-index: 100;
+  background-color: var(--bg);
+  overflow-y: auto;
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+  transform: translateY(16px);
+  transition:
+    opacity var(--nav-duration) var(--nav-ease),
+    transform var(--nav-duration) var(--nav-ease),
+    visibility 0ms linear var(--nav-duration);
+}
+
+.room-view[data-open="true"] {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: translateY(0);
+  transition:
+    opacity var(--nav-duration) var(--nav-ease),
+    transform var(--nav-duration) var(--nav-ease),
+    visibility 0ms linear 0ms;
+}
+
+.room-view-inner {
+  padding-block: var(--sp-10);
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-8);
+}
+
+.room-view-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-4);
+  padding-bottom: var(--sp-4);
+  border-bottom: 1px solid var(--border);
+}
+
+.back-link {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: var(--sp-2) var(--sp-4);
+  border: 1px solid var(--border-strong);
+  border-radius: 4px;
+  background-color: var(--bg-elevated);
+  color: var(--ink);
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  font-weight: 500;
+}
+
+.back-link:hover {
+  background-color: var(--bg-subtle);
+}
+
+.room-view-index {
+  font-size: var(--fs-sm);
+  line-height: 20px;
+  letter-spacing: 0.08em;
+  color: var(--ink-muted);
+}
+
+.room-view-stage {
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-6);
+  max-width: 720px;
+}
+
+.room-view-accent {
+  height: 8px;
+  width: 96px;
+  border-radius: 2px;
+  background-color: var(--room-accent, var(--ink-muted));
+}
+
+.room-view-title {
+  font-family: var(--font-serif);
+  font-size: var(--fs-xl);
+  line-height: 36px;
+  font-weight: 400;
+  color: var(--ink);
+}
+
+.room-view-subtitle {
+  font-size: var(--fs-lg);
+  line-height: 28px;
+  color: var(--ink-muted);
+}
+
+.room-view-summary {
+  font-size: var(--fs-base);
+  line-height: 28px;
+  color: var(--ink-secondary);
+  max-width: 576px;
+}
+
+/* Responsive breakpoints */
+@media (max-width: 1024px) {
+  .hero {
+    padding-top: var(--sp-16);
+    padding-bottom: var(--sp-12);
+  }
+
+  .rooms-grid,
+  .info-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: var(--sp-6);
+  }
+}
+
+@media (max-width: 640px) {
+  :root {
+    --fs-hero: 36px;
+  }
+
+  .container {
+    padding-inline: var(--sp-4);
+  }
+
+  .hero {
+    padding-top: var(--sp-10);
+    padding-bottom: var(--sp-8);
+  }
+
+  .hero-title {
+    line-height: 44px;
+    margin-bottom: var(--sp-6);
+  }
+
+  .rooms-grid,
+  .info-grid {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--sp-4);
+  }
+
+  .room-card-body,
+  .info-item {
+    padding: var(--sp-6);
+  }
+
+  .footer-inner {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+}
+
+/* Reduced motion */
+@media (prefers-reduced-motion: reduce) {
+  :root {
+    --nav-duration: 0.01ms;
+  }
+
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
