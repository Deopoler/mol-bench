+
+function formatOklch(accent) {
+  if (Array.isArray(accent) && accent.length >= 3) {
+    const [l, c, h] = accent;
+    return `oklch(${Number(l).toFixed(3)} ${Number(c).toFixed(3)} ${Number(h).toFixed(1)})`;
