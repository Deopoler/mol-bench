+  font-weight: 600;
+  letter-spacing: -0.02em;
+  max-width: 720px;
+}
+
+.hero-body {
+  font-size: var(--text-base);
+  line-height: var(--lh-base);
+  color: var(--ink-muted);
+  max-width: 480px;
+}
+
+/* Collection */
+.collection {
+  padding-top: var(--s-20);
+  padding-bottom: var(--s-20);
+  border-bottom: 1px solid var(--border);
+}
+
+.section-head {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--s-2);
+  margin-bottom: var(--s-10);
+}
+
+.section-title {
+  font-size: var(--text-xl);
+  line-height: var(--lh-xl);
+  font-weight: 600;
+  letter-spacing: -0.015em;
+}
+
+.section-count {
+  font-size: var(--text-sm);
+  line-height: var(--lh-sm);
+  color: var(--ink-muted);
+}
+
+.room-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--s-8);
+}
+
+.room-card {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  border-radius: 4px;
+  background-color: var(--surface);
+  border: 1px solid var(--border);
+}
+
+.room-card__link,
+.room-card__inner {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-width: 0;
+  border-radius: 4px;
+}
+
+.room-card__link {
+  transition: background-color var(--transition-ui) ease, border-color var(--transition-ui) ease;
+}
+
+.room-card__link:hover {
