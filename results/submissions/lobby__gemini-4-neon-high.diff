+/* Museum of Light — Lobby
+ * Editorial layout on a strict 4px spacing grid and 5-step typographic scale.
+ * System font stacks only (offline-safe, zero external requests).
+ */
+
+:root {
+  /* Spacing scale (strict multiples of 4px) */
+  --s-1: 4px;
+  --s-2: 8px;
+  --s-3: 12px;
+  --s-4: 16px;
+  --s-5: 20px;
+  --s-6: 24px;
+  --s-8: 32px;
+  --s-10: 40px;
+  --s-12: 48px;
+  --s-16: 64px;
+  --s-20: 80px;
+  --s-24: 96px;
+  --s-28: 112px;
+  --s-30: 120px;
+  --s-32: 128px;
+  --s-34: 136px;
+
+  /* 5-step type scale: 14 / 16 / 20 / 28 / 48 (min ratio 1.143 >= 1.125) */
+  --text-sm: 14px;
+  --text-base: 16px;
+  --text-lg: 20px;
+  --text-xl: 28px;
+  --text-hero: 48px;
+
+  --lh-sm: 20px;
+  --lh-base: 28px;   /* 28 / 16 = 1.75: ideal for both Hangul (1.5-1.9) and Latin (1.4-1.8) */
+  --lh-lg: 28px;
+  --lh-xl: 36px;
+  --lh-hero: 56px;
+
+  --font-sans: "Apple SD Gothic Neo", "Malgun Gothic", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+
+  /* Light theme (warm architectural limestone) */
+  --bg: #f7f5f0;
+  --surface: #fbfaf6;
+  --surface-muted: #f0ede5;
+  --ink: #2c2b27;
+  --ink-muted: #5d5a52;
+  --border: #eae6dd;
+  --border-strong: #ccc6ba;
+  --focus-ring: #173b61;
+  --soon-bg: #ece7dc;
+  --soon-ink: #434039;
+  --room-backdrop: #1e2128;
+  --room-surface: #252932;
+  --room-ink: #f4f1ea;
+  --room-ink-muted: #c2beb4;
+  --room-border: #3a3f4c;
+
+  --transition-nav: 320ms;
+  --transition-ui: 160ms;
+}
+
+html[data-theme="dark"] {
+  --bg: #121316;
+  --surface: #181a1f;
+  --surface-muted: #14161b;
+  --ink: #f1efe9;
+  --ink-muted: #b5b1a7;
+  --border: #272b33;
+  --border-strong: #464c5a;
+  --focus-ring: #f2cc78;
+  --soon-bg: #22252e;
+  --soon-ink: #cbc6bc;
+  --room-backdrop: #0b0c0f;
+  --room-surface: #15181e;
+  --room-ink: #f4f1ea;
+  --room-ink-muted: #bdb9af;
+  --room-border: #2d323e;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html {
+  background-color: var(--bg);
+  color: var(--ink);
+  font-family: var(--font-sans);
+  font-size: var(--text-base);
+  line-height: var(--lh-base);
+  -webkit-text-size-adjust: 100%;
+  color-scheme: light;
+}
+
+html[data-theme="dark"] {
+  color-scheme: dark;
+}
+
+body {
+  margin: 0;
+  background-color: var(--bg);
+  color: var(--ink);
+  font-family: var(--font-sans);
+  font-size: var(--text-base);
+  line-height: var(--lh-base);
+  word-break: keep-all;
+  overflow-wrap: break-word;
+  overflow-x: clip;
+}
+
+h1,
+h2,
+h3,
+p,
+dl,
+dt,
+dd {
+  margin: 0;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+button {
+  font-family: inherit;
+  font-size: var(--text-sm);
+  line-height: var(--lh-sm);
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: pointer;
+}
+
+/* High-contrast focus indication (>= 3:1 contrast, >= 2x perimeter pixels) */
+a:focus,
+a:focus-visible,
+button:focus,
+button:focus-visible,
