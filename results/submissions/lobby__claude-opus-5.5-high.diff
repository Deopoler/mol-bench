diff --git a/lobby/lobby.css b/lobby/lobby.css
new file mode 100644
index 0000000..548b45a
--- /dev/null
+++ b/lobby/lobby.css
@@ -0,0 +1,373 @@
+/* Museum of Light — lobby. System font stacks only (no font requests). 4 px spacing rhythm. */
+:root {
+  color-scheme: light;
+  --bg: #f6f2ea;
+  --surface: #fffcf6;
+  --ink: #1d1a16;
+  --muted: #595247;
+  --line: #ddd5c7;
+  --line-strong: #8a8172;
+  --soon-bg: #efe9de;
+  --glow: rgba(214, 160, 72, 0.22);
+  --glow-2: rgba(120, 150, 210, 0.14);
+  --font-sans: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --font-serif: "Nanum Myeongjo", "AppleMyungjo", "Batang", Georgia, "Times New Roman", serif;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    color-scheme: dark;
+    --bg: #14120f;
+    --surface: #1c1915;
+    --ink: #f2ede4;
+    --muted: #b6ad9f;
+    --line: #353029;
+    --line-strong: #8f8676;
+    --soon-bg: #191713;
+    --glow: rgba(214, 160, 72, 0.16);
+    --glow-2: rgba(120, 150, 210, 0.12);
+  }
+}
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --bg: #14120f;
+  --surface: #1c1915;
+  --ink: #f2ede4;
+  --muted: #b6ad9f;
+  --line: #353029;
+  --line-strong: #8f8676;
+  --soon-bg: #191713;
+  --glow: rgba(214, 160, 72, 0.16);
+  --glow-2: rgba(120, 150, 210, 0.12);
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+* { margin: 0; }
+[hidden] { display: none !important; }
+
+html { -webkit-text-size-adjust: 100%; }
+body {
+  background: var(--bg);
+  color: var(--ink);
+  font-family: var(--font-sans);
+  font-size: 17px;
+  line-height: 1.7;
+  overflow-x: hidden;
+  word-break: keep-all;
+  overflow-wrap: break-word;
+  min-height: 100vh;
+}
+:lang(en) { word-break: normal; }
+
+.wrap {
+  width: 100%;
+  max-width: 1264px;
+  margin-inline: auto;
+  padding-inline: 32px;
+}
+
+/* ---------- Header ---------- */
+.site-header { border-bottom: 1px solid var(--line); }
+.header-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  padding-block: 12px;
+}
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 44px;
+  font-size: 17px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+}
+.brand::before {
+  content: "";
+  flex: none;
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  background: radial-gradient(circle at 35% 35%, #ffe7b0 0 24%, #d9a04b 60%, #9a6a2a 100%);
+  box-shadow: 0 0 0 4px var(--glow);
+}
+.controls { display: flex; gap: 8px; }
+.control {
+  font: inherit;
+  font-size: 14px;
+  line-height: 1.4;
+  color: var(--ink);
+  background: var(--surface);
+  border: 1px solid var(--line-strong);
+  border-radius: 999px;
+  min-height: 44px;
+  padding: 8px 16px;
+  cursor: pointer;
+  transition: background-color 160ms ease, border-color 160ms ease;
+}
+.control:hover { border-color: var(--ink); }
+
+:focus-visible {
+  outline: 3px solid var(--ink);
+  outline-offset: 4px;
+}
+
+/* ---------- Hero ---------- */
+.hero {
+  display: flex;
+  align-items: center;
+  min-height: calc(100vh - 69px);
+  padding-block: 96px 80px;
+  background:
+    radial-gradient(640px 360px at var(--light-x, 78%) var(--light-y, 30%), var(--glow), transparent 70%),
+    radial-gradient(520px 320px at var(--light-x2, 18%) 100%, var(--glow-2), transparent 70%);
+  border-bottom: 1px solid var(--line);
+}
+.eyebrow {
+  font-size: 14px;
+  line-height: 1.6;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted);
+  margin-bottom: 16px;
+}
+h1 {
+  font-family: var(--font-serif);
+  font-size: 56px;
+  line-height: 1.25;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  max-width: 880px;
+  text-wrap: balance;
+}
+.lead {
+  margin-top: 24px;
+  max-width: 600px;
+  font-size: 17px;
+  line-height: 1.75;
+  color: var(--ink);
+}
+
+.hero-cta {
+  display: inline-block;
+  margin-top: 32px;
+  padding-block: 12px;
+  font-size: 14px;
+  line-height: 20px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  color: var(--ink);
+  text-decoration: none;
+  border-bottom: 1px solid var(--line-strong);
+}
+.hero-cta::after { content: " ↓"; }
+.hero-cta:hover { border-bottom-color: var(--ink); }
+
+/* ---------- Rooms ---------- */
+.rooms { padding-block: 80px; }
+.section-head { margin-bottom: 32px; }
+.section-head .meta { margin-top: 4px; }
+h2 {
+  font-family: var(--font-serif);
+  font-size: 30px;
+  line-height: 1.35;
+  font-weight: 700;
+}
+.meta { font-size: 14px; line-height: 1.6; color: var(--muted); }
+
+.room-grid {
+  list-style: none;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
+  gap: 24px;
+}
+.room-grid > li { display: flex; min-width: 0; }
+
+.card {
+  --accent: oklch(0.68 0.12 60);
+  position: relative;
+  display: grid;
+  grid-template-rows: auto auto auto 1fr auto;
+  row-gap: 8px;
+  width: 100%;
+  min-width: 0;
+  padding: 28px 24px 24px;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  color: inherit;
+  text-decoration: none;
+  transition: border-color 160ms ease, transform 160ms ease;
+}
+.card::before {
+  content: "";
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 4px;
+  border-radius: 16px 16px 0 0;
+  background: var(--accent);
+}
+a.card:hover { border-color: var(--line-strong); transform: translateY(-2px); }
+a.card:focus-visible { border-color: var(--ink); }
+.card-no {
+  display: block;
+  font-size: 14px;
+  line-height: 1.6;
+  color: var(--muted);
+  letter-spacing: 0.04em;
+}
+.card-no::before {
+  content: "";
+  display: inline-block;
+  vertical-align: 2px;
+  margin-right: 8px;
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--accent);
+  flex: none;
+}
+.card h3 {
+  font-size: 22px;
+  line-height: 1.45;
+  font-weight: 700;
+  min-width: 0;
+}
+.card-alt { font-size: 14px; line-height: 1.6; color: var(--muted); }
+.card-summary { margin-top: 4px; font-size: 17px; line-height: 1.7; color: var(--ink); }
+.card-cta {
+  margin-top: 8px;
+  font-size: 14px;
+  line-height: 1.6;
+  font-weight: 700;
+}
+.card-cta::after { content: " →"; }
+
+.card.is-soon {
+  background: var(--soon-bg);
+  border-style: dashed;
+  border-color: var(--line-strong);
+}
+.card.is-soon::before { background: repeating-linear-gradient(90deg, var(--line-strong) 0 8px, transparent 8px 16px); }
+.card.is-soon .card-no::before { background: transparent; border: 1px solid var(--line-strong); }
+.card.is-soon h3, .card.is-soon .card-summary { color: var(--muted); }
+.card.is-soon .card-cta { color: var(--muted); font-weight: 400; }
+.card.is-soon .card-cta::after { content: ""; }
+.badge {
+  display: inline-block;
+  margin-left: 8px;
+  padding: 0 8px;
+  border: 1px solid var(--line-strong);
+  border-radius: 999px;
+  font-size: 14px;
+  line-height: 1.6;
+  color: var(--ink);
+}
+
+.empty {
+  padding: 48px 32px;
+  border: 1px dashed var(--line-strong);
+  border-radius: 16px;
+  background: var(--surface);
+  max-width: 664px;
+}
+.empty-title { font-size: 22px; line-height: 1.45; }
+.empty-text { margin-top: 12px; color: var(--muted); }
+
+/* ---------- Visit ---------- */
+.visit { padding-block: 80px 96px; border-top: 1px solid var(--line); }
+.visit h2 { margin-bottom: 24px; }
+.prose { max-width: 600px; line-height: 1.75; }
+.prose + .prose { margin-top: 16px; }
+
+/* ---------- Room view (route overlay) ---------- */
+.room-view {
+  position: fixed;
+  inset: 0;
+  z-index: 10;
+  overflow-y: auto;
+  background: var(--bg);
+  display: flex;
+  align-items: center;
+  opacity: 0;
+  transform: translateY(16px);
+  visibility: hidden;
+  transition: opacity 320ms ease-out, transform 320ms ease-out, visibility 0ms linear 320ms;
+}
+.room-view.is-open {
+  opacity: 1;
+  transform: none;
+  visibility: visible;
+  transition: opacity 320ms ease-out, transform 320ms ease-out, visibility 0ms linear 0ms;
+}
+.room-view::before {
+  content: "";
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 8px;
+  background: var(--room-accent, var(--line-strong));
+}
+.room-view-inner { padding-block: 64px; }
+.room-view h2 { font-size: 56px; line-height: 1.25; max-width: 880px; }
+.room-view h2:focus { outline: none; }
+.room-view-alt { margin-top: 12px; font-size: 22px; line-height: 1.45; color: var(--muted); }
+.room-view-summary { margin-top: 24px; max-width: 600px; line-height: 1.75; }
+.room-view-note { margin-top: 12px; max-width: 600px; color: var(--muted); }
+.back { margin-top: 32px; }
+
+/* ---------- Footer ---------- */
+.site-footer { border-top: 1px solid var(--line); }
+.footer-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px 24px;
+  padding-block: 24px;
+}
+.footer-note { font-size: 14px; line-height: 1.6; color: var(--muted); }
+.footer-nav { display: block; }
+.footer-nav a {
+  display: inline-block;
+  padding-block: 12px;
+  margin-right: 16px;
+  font-size: 14px;
+  line-height: 20px;
+  color: var(--ink);
+  text-underline-offset: 4px;
+}
+
+/* ---------- Responsive ---------- */
+@media (max-width: 960px) {
+  h1 { font-size: 48px; }
+  .room-view h2 { font-size: 44px; }
+}
+@media (max-width: 600px) {
+  .wrap { padding-inline: 16px; }
+  .hero { min-height: 0; padding-block: 56px 48px; }
+  h1 { font-size: 36px; line-height: 1.3; }
+  h2 { font-size: 26px; }
+  .rooms, .visit { padding-block: 56px; }
+  .card { padding: 24px 20px 20px; }
+  .card h3 { font-size: 20px; }
+  .card-summary { font-size: 16px; }
+  body { font-size: 16px; }
+  .lead, .prose { font-size: 16px; }
+  .empty { padding: 32px 20px; }
+  .room-view h2 { font-size: 36px; line-height: 1.3; }
+  .room-view-alt { font-size: 20px; }
+  .control { padding: 8px 12px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    transition-duration: 0ms !important;
+    transition-delay: 0ms !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+  a.card:hover { transform: none; }
+}
