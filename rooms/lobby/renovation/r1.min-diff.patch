 body{margin:0;font:16px Arial,sans-serif;background:#faf9f5;color:#393832}header{padding:20px 5%;border-bottom:1px solid #ddd;display:flex;justify-content:space-between;align-items:center}button{padding:6px}main{max-width:1100px;margin:35px auto;padding:0 24px}h1{font-size:48px;line-height:1.3}p{line-height:1.65;max-width:680px}#room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.room-card{padding:19px;border:1px solid #ccc;color:inherit;text-decoration:none;min-height:170px}.room-card h3{font-size:18px}.room-card p{font-size:14px}footer{padding:28px 5%;margin-top:40px;border-top:1px solid #ddd}a:focus-visible,button:focus-visible{outline:2px solid #a43}html.dark{background:#222;color:#eee}html.dark body{background:#222;color:#eee}@media(max-width:700px){#room-grid{grid-template-columns:repeat(2,1fr)}h1{font-size:36px}}@media(max-width:400px){#room-grid{grid-template-columns:1fr}}
